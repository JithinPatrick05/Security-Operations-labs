// Case 009
// User domain, public IP and external forwarding address are intentionally redacted

let AffectedUserPrefix = "finance.manager";
let SuspiciousSource = "REDACTED_PUBLIC_IP";
let ForwardingDestination = "REDACTED_EXTERNAL_MAILBOX";

// Review the affected user's sign in timeline
SigninLogs
| where TimeGenerated between (datetime(2026-11-04 07:45:00) .. datetime(2026-11-04 09:00:00))
| where UserPrincipalName startswith AffectedUserPrefix
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName,
          ClientAppUsed, DeviceDetail, ResultType, ResultDescription,
          RiskLevelDuringSignIn, ConditionalAccessStatus
| order by TimeGenerated asc

// Scope the suspicious source across users
SigninLogs
| where TimeGenerated > ago(7d)
| where IPAddress == SuspiciousSource
| summarize Attempts=count(),
            Successful=countif(ResultType == 0),
            FirstSeen=min(TimeGenerated),
            LastSeen=max(TimeGenerated)
  by UserPrincipalName, IPAddress
| order by Attempts desc

// Review successful sign ins carrying elevated risk
SigninLogs
| where TimeGenerated > ago(7d)
| where ResultType == 0
| where RiskLevelDuringSignIn in~ ("high", "medium")
| project TimeGenerated, UserPrincipalName, IPAddress, Location,
          DeviceDetail, RiskLevelDuringSignIn, ConditionalAccessStatus
| order by TimeGenerated desc

// Review inbox rule and mailbox forwarding changes
OfficeActivity
| where TimeGenerated between (datetime(2026-11-04 07:45:00) .. datetime(2026-11-04 09:00:00))
| where UserId startswith AffectedUserPrefix
| where Operation in~ ("New-InboxRule", "Set-InboxRule", "Remove-InboxRule", "Set-Mailbox")
| project TimeGenerated, UserId, Operation, ClientIP, Parameters, ResultStatus
| order by TimeGenerated asc

// Search for the external forwarding destination
OfficeActivity
| where TimeGenerated > ago(30d)
| where Parameters has ForwardingDestination
| project TimeGenerated, UserId, Operation, ClientIP, Parameters, ResultStatus
| order by TimeGenerated desc

// Review external forwarding activity across the tenant
OfficeActivity
| where TimeGenerated > ago(30d)
| where Operation in~ ("New-InboxRule", "Set-InboxRule", "Set-Mailbox")
| where Parameters has_any ("ForwardTo", "RedirectTo", "ForwardingSmtpAddress")
| project TimeGenerated, UserId, Operation, ClientIP, Parameters, ResultStatus
| order by TimeGenerated desc
